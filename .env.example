# Runtime configuration. The proxy reads these from its environment at start.
# On the server, put them in /etc/keyproxy.env (the systemd unit loads it).
# Never commit a filled-in copy. Secrets must not be compiled into the binary.

# REQUIRED unless UPSTREAM_KEYS is set. The real upstream API key. Injected
# server-side, never sent to clients. This is a key ring of one.
UPSTREAM_API_KEY=

# Optional. The key ring: comma list of `label:key`, or bare keys which are
# numbered key1, key2. Takes precedence over UPSTREAM_API_KEY. Keys move on a
# 401/402 (retired) or a per-key 429 (cooldown), never on platform capacity.
# UPSTREAM_KEYS=primary:sk-...,secondary:sk-...

# Optional. Balance floor in the control plane's unit. Default 0.50. A key at
# or below it stops being chosen.
# KEY_MIN_BALANCE=0.50

# Optional. Balance endpoint for the key ring. Unset turns the poller off, so
# keys are only retired after the upstream refuses them. The poll sends a
# browser User-Agent because some control planes refuse the default one.
# KEY_BALANCE_URL=https://control.example.com/api/me

# Optional. How often each key's balance is read, in seconds. Default 300.
# KEY_BALANCE_INTERVAL_SECS=300

# REQUIRED. Upstream origin, with no /v1 and no trailing slash.
UPSTREAM_BASE_URL=https://api.example.com

# REQUIRED. Bearer token for /stats. Separate from caller tokens.
ADMIN_TOKEN=

# REQUIRED. File of issued caller tokens (stores only SHA-256 hashes).
# Create entries with: keyproxy issue <label>
# Remove entries with: keyproxy revoke <label>, then restart the service.
TOKENS_FILE=/etc/keyproxy/tokens.txt

# Optional. Path the install route is mounted at. Unset means the route is not
# registered at all, so a deployment that issues tokens by hand exposes nothing.
# Must start with a slash. Deliberately unset here: the real path is deployment
# state and is not committed.
# INSTALL_PATH=/internal/install

# Optional. File of install ids (one per line) allowed to fetch their own token
# from the install route. Each id gets one token. NOT YET READ BY THE BINARY:
# the route currently issues to any well-formed id, bounded only by the daily
# rate cap below. See issue #9.
# INSTALL_ALLOWLIST=/etc/keyproxy/installs.txt

# Optional. Install-route requests allowed per client IP per day. Default 5000.
# INSTALL_RATE_PER_DAY=5000

# Optional. Response header naming the publisher that served a request. Recorded
# per row as upstream_publisher. Unset leaves that column empty.
# PUBLISHER_HEADER=x-publisher

# Where to listen. Behind nginx, keep it on localhost.
BIND_ADDR=127.0.0.1:8787

# Upstream model ids this proxy serves (comma list). Others are refused.
ALLOWED_MODELS=deepseek-v4.1-flash

# Image generation ids, served only on /v1/images/* (comma list). Written
# exactly as the upstream lists them, `provider/model`. The proxy sends the id
# on unchanged: it never adds or strips a prefix. Empty turns image generation
# off. An id may not also appear in ALLOWED_MODELS.
# IMAGE_MODELS=cb/gemini-2.5-flash-image

# Requests per minute per caller token.
RATE_MAX_PER_MIN=60

# Optional. Ceiling on the estimated input of one request, in tokens. Default
# 200000. A request that reaches it is refused with 413 before any upstream
# call and recorded as input_too_large. Global: one value for every caller.
# 0 disables it. The estimate is per part: text at 4 characters per token, 1000
# per image or audio part, bytes/4 when the body is not JSON.
#
# The ceiling is applied to a calibrated estimate, not the raw one. The proxy
# learns each caller's density from prompt_tokens / estimated_tokens on served
# responses, folds it into a running mean, and clamps the factor to [1.0, 3.0]
# so the gate can only ever tighten. A caller with fewer than 20 observations
# falls back to the shared factor, and to 1.0 when that is thin too. The factor
# is seeded from 7 days of stored rows at boot. No knob for any of it.
# MAX_INPUT_TOKENS=200000

# The largest body accepted is 25 MB, matching `client_max_body_size 25m` on the
# nginx host in front of the proxy. Not configurable.

# Path to the SQLite stats database. Persists across restarts.
STATS_DB=/var/lib/keyproxy/stats.db

# How often the upstream health probe runs, in seconds. Default 300. The probe
# sends one one-token request per configured rotation candidate per cycle, so
# it reports per-candidate health instead of inferring it from caller traffic.
# A value of 0 falls back to the default rather than disabling the probe.
# PROBE_INTERVAL_SECS=300

# Ceiling on a single probe request, in seconds. Default 40.
# PROBE_TIMEOUT_SECS=40

# Models to probe, comma list. Defaults to every ROTATION_MODELS candidate.
# Set it to probe a model that is not in the rotation.
# PROBE_MODELS=deepseek-v4.1-flash,combo/cheapest

# Log level.
RUST_LOG=info
